rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Employees Collection (Guru & Staf MTs Darul Huda)
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isValidId(employeeId);
    }

    // Attendance Records Collection (Transaksi Presensi)
    match /attendance_records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isValidId(recordId);
    }

    // Settings Collection (Jam Kerja & Konfigurasi)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Offices / Geofence locations
    match /offices/{officeId} {
      allow read: if true;
      allow write: if isValidId(officeId);
    }
  }
}
